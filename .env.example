# --- LLM providers (M1) ---
# OpenRouter free tier (primary). Get a key at https://openrouter.ai/keys
# Model "openrouter/free" auto-selects a working free model that supports
# the tools you request. Override with e.g. qwen/qwen3-coder:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Google AI Studio (fallback): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local Ollama (last resort, no key): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Anthropic (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# OpenAI (paid): https://platform.openai.com/
OPENAI_API_KEY=
GPT_MODEL=gpt-4.1-mini

# --- Server (M1) ---
PORT=8787
# Simple bearer token for gateway/auth.ts; the UI sends it as "dev-token"
AUTH_TOKEN=dev-token
# Absolute path of the workspace when the UI does not provide one
DEFAULT_WORKSPACE_ROOT=
